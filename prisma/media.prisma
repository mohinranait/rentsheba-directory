model Media {
  id          String   @id @default(uuid())
  url         String
  alt         String?
  public_id   String
  extension   String
  secure_url  String
  size        String

  category    Category?   

   // Logo relation
  logoListing       Listing? @relation("ListingLogo")

  // Thumbnail relation
  thumbnailListing  Listing? @relation("ListingThumbnail")

  // Gallery relation
  galleryListing    Listing? @relation("ListingGallery",  fields: [galleryListingId],  references: [id] )

  galleryListingId  String?


  createdAt   DateTime @default(now())

  @@index([galleryListingId])
}
