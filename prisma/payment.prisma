model Payment {
  id                    String         @id @default(uuid())

  subscriptionId        String         @unique

  // General or bKash transaction ID
  transactionId         String?        @unique

  // bKash payment ID returned on create
  paymentID             String?

  // bKash MFS transaction ID (trxID) from execute/query
  trxID                 String?

  // Merchant invoice number sent to bKash
  merchantInvoiceNumber String?

  amount                Decimal

  currency              String         @default("BDT")

  method                PaymentMethod  @default(BKASH)

  status                PaymentStatus  @default(PENDING)

  customerMsisdn        String?

  failureReason         String?

  metadata              Json?

  paidAt                DateTime?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  subscription          Subscription   @relation( fields: [subscriptionId], references: [id], onDelete: Cascade )

  @@index([transactionId])
  @@index([paymentID])
  @@index([trxID])
  @@index([merchantInvoiceNumber])
  @@index([status])
}