<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HealthCare - Verify Your Email</title>
</head>

<body
  style="margin: 0; padding: 0; background-color: #f4f7fb; font-family: Arial, Helvetica, sans-serif; color: #1f2937;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7fb; padding: 40px 15px;">
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0"
          style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden;">

          <!-- Header -->
          <tr>
            <td align="center" style="background-color: #0f766e; padding: 28px 20px;">
              <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: 700;">
                HealthCare
              </h1>

              <p style="margin: 8px 0 0; color: #d1fae5; font-size: 14px;">
                Your health, our priority
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 40px 35px;">

              <h2 style="margin: 0 0 15px; color: #111827; font-size: 24px;">
                Verify Your Email
              </h2>

              <p style="margin: 0 0 15px; font-size: 16px; line-height: 1.7;">
                Hello <strong>
                  <%= name %>
                </strong>,
              </p>

              <p style="margin: 0 0 25px; font-size: 15px; line-height: 1.7; color: #4b5563;">
                Welcome to <strong>HealthCare</strong>! We're happy to have you
                with us. Please verify your email address using the verification
                code below to complete your registration.
              </p>

              <!-- OTP Box -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="
                      background-color: #f0fdfa;
                      border: 1px solid #99f6e4;
                      border-radius: 10px;
                      padding: 25px;
                    ">

                    <p style="margin: 0 0 10px; color: #64748b; font-size: 13px;">
                      Your verification code
                    </p>

                    <div style="
                      font-size: 34px;
                      font-weight: 700;
                      letter-spacing: 8px;
                      color: #0f766e;
                    ">
                      <%= otp %>
                    </div>

                    <p style="margin: 15px 0 0; color: #64748b; font-size: 13px;">
                      This code will expire in
                      <strong>
                        <%= expireTime %> minutes
                      </strong>.
                    </p>

                  </td>
                </tr>
              </table>

              <p style="margin: 28px 0 0; font-size: 14px; line-height: 1.7; color: #6b7280;">
                If you didn't create a HealthCare account, you can safely ignore
                this email.
              </p>

              <p style="margin: 25px 0 0; font-size: 15px; color: #374151;">
                Welcome aboard,<br />
                <strong>The HealthCare Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="
                background-color: #f8fafc;
                padding: 22px 20px;
                border-top: 1px solid #e5e7eb;
              ">

              <p style="margin: 0; font-size: 12px; color: #94a3b8;">
                © <%= new Date().getFullYear() %> HealthCare. All rights reserved.
              </p>

              <p style="margin: 8px 0 0; font-size: 12px; color: #94a3b8;">
                This is an automated email. Please do not reply to this message.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>

</html>